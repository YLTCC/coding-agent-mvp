# ===== 模型配置（OpenAI 兼容接口，DeepSeek / 通义千问 / Kimi 等都适用）=====
# DeepSeek API Key 获取地址：https://platform.deepseek.com/api_keys
LLM_API_KEY=sk-在这里填入你的key

# DeepSeek 的接口地址（默认即可；用其他厂商时改成对应的 base_url）
LLM_BASE_URL=https://api.deepseek.com

# 模型名：DeepSeek 用 deepseek-chat（V3 系列）；也可按需换成其他模型名
LLM_MODEL=deepseek-flash

# 单次请求超时秒数（默认 120；openai SDK 默认 600，挂起太久）
# LLM_TIMEOUT_SECONDS=120
# 429/5xx/网络抖动时的最大重试次数（默认 3；401/400 等参数或密钥错误不重试）
# LLM_MAX_RETRIES=3
# 重试指数退避基数秒数（默认 1.0：实际等待 1s/2s/4s + 抖动，封顶 30s）
# LLM_RETRY_BASE_DELAY=1.0

# ===== Agent 运行配置（均为可选项，用默认值即可先跑起来）=====
# Agent 的工作目录（沙箱根目录），Agent 只能读写这个目录内的文件
# 不填则默认为你启动程序时所在的目录
# AGENT_WORKSPACE=./workspace

# 单次任务最多允许 Agent 循环多少轮（防止死循环烧 token）
MAX_ITERATIONS=25

# 工具返回结果最多保留多少字符（超长自动截断，防止上下文爆炸）
MAX_TOOL_OUTPUT_CHARS=8000

# 是否自动批准写文件 / 执行命令（true=不再询问，false=每次高危操作前需人工确认）
AUTO_APPROVE=false

# ---------- 会话日志（JSONL，note3 的那套格式）----------
# 是否把会话落盘成 append-only 的 JSONL
SESSION_LOG_ENABLED=true
# 会话文件目录（相对路径按当前工作目录解析）
#
# ⚠️ CLI 模式下默认就是 ./sessions —— 它在工作目录**里面**（单用户 MVP 可接受）。
#    这道口子靠 tools 里的"按路径判"守卫兜底（读/写会话审计日志一律拒）。
# ⚠️ Web 模式下**必须**在工作区之外，否则启动直接失败（拒绝启动并给出修法）：
#    会话 A 的 agent 一句 `read_file sessions/<B>.jsonl` 就能读到 B 的全部对话，
#    还能用 write_file/edit_file 篡改审计日志（"事后不可抵赖"就没了）。
#    不配这一项时，Web 模式的默认值是 %LOCALAPPDATA%\coding-agent\sessions。
# AGENT_SESSION_DIR=sessions

# ---------- Web 层（阶段三·b：FastAPI + SSE）----------
# 监听地址。**默认只绑 127.0.0.1**。
# 🔴 改成 0.0.0.0 而**又没配 WEB_TOKEN** = 把你的 CMD 开放给全网：
#    run_command 的白名单挡的是"危险命令形态"，挡不住"用 python 跑一个脚本"。
# WEB_HOST=127.0.0.1
# WEB_PORT=8000

# 访问口令：请求需带 `Authorization: Bearer <token>`；
# SSE 用 `?token=<token>`（EventSource 不能设 header）。留空 = 不鉴权。
# WEB_TOKEN=

# 工作区根：前端只能提交**工作区名字**，服务端 resolve 后校验它在这个根之下
# （不允许提交任意路径，否则沙箱边界形同虚设）。留空 = 用 AGENT_WORKSPACE / 当前目录
# WEB_WORKSPACE_ROOT=

# 审批超时秒数。等不到答案时**默认拒绝**（fail-closed）——
# 放行 = 把沙箱交给网络抖动。客户端断线时立即拒绝，不白等。
# WEB_APPROVAL_TIMEOUT=300

# SSE 事件队列上限。消费者（浏览器）会随时消失，而任务会继续跑完，
# 所以队列**必须有界**，否则长任务 + 关掉的标签页会攒到几百 MB。
# WEB_QUEUE_MAXSIZE=256

# 前端静态文件目录（默认 web/static）
# WEB_STATIC_DIR=

